# Required for the browser Supabase client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Required for Razorpay checkout in the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_or_test_key_id

# Keep these exact Supabase Edge Function names. The local folders deploy to these names.
NEXT_PUBLIC_PAYMENT_CREATE_ORDER_FUNCTION=payment-create-order
NEXT_PUBLIC_PAYMENT_VERIFY_FUNCTION=payment-verify

# Optional, used by metadata/sitemap and any URL generation
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
NEXT_PUBLIC_APP_NAME=PinCodeMart

# Optional, only needed if Google Maps/OAuth flows are enabled in your Supabase project
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Set these in Supabase Edge Function secrets, not Vercel, unless you add Next API routes
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
